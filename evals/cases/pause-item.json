{
  "description": "/pause records where a built item stands in paused.md (Status: PAUSED, where it stands, how to resume) so anyone can pick it up.",
  "command": "pause",
  "arguments": "L1 waiting on pricing sign-off",
  "workItem": "L1-bulk-discount",
  "branch": "dev/feature/L1-bulk-discount",
  "work": [
    {
      "from": "L1/start",
      "to": "L1-bulk-discount"
    },
    {
      "from": "L1/spec-approved",
      "to": "L1-bulk-discount"
    },
    {
      "from": "L1/plan-approved",
      "to": "L1-bulk-discount"
    },
    {
      "from": "L1/built",
      "to": "L1-bulk-discount"
    }
  ],
  "expect": {
    "files": [
      {
        "path": ".work/L1-bulk-discount/paused.md",
        "status": "PAUSED",
        "headings": [
          "## Where it stands",
          "## To resume"
        ],
        "matches": [
          "(?i)sign-off"
        ]
      }
    ],
    "repo": {
      "allow": []
    }
  },
  "grader": "Test-Expect"
}
