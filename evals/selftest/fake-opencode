#!/usr/bin/env bash
# A stand-in for opencode, used only by evals/Test-Harness.ps1. It never calls a model.
# Tandem arm: writes the files /spec would (spec, plan, tasks), checks the gate was approved, and the last task
# lays down a correct implementation. Plain prompt: writes an implementation with the rate inline (a bad outcome).
# Every call is logged to $FAKE_LOG with its arguments and XDG_CONFIG_HOME.
set -u
echo "args= $* | xdg=${XDG_CONFIG_HOME:-}" >> "$FAKE_LOG"
cmd=""; prev=""
for a in "$@"; do
  if [ "$prev" = "--command" ]; then cmd="$a"; fi
  prev="$a"
done
work=".work/L1-bulk-discount"
# What opencode run --format json prints: one JSON event per line.
finish() { echo "{\"type\":\"step_finish\",\"timestamp\":1,\"sessionID\":\"ses_x\",\"part\":{\"type\":\"step-finish\",\"tokens\":{\"input\":$1,\"output\":$2,\"reasoning\":0,\"cache\":{\"read\":10,\"write\":0}},\"cost\":$3}}"; }
tool() { echo "{\"type\":\"tool_use\",\"timestamp\":1,\"sessionID\":\"ses_x\",\"part\":{\"type\":\"tool\",\"tool\":\"$1\",\"state\":{\"status\":\"completed\"}}}"; }
echo "not json, ignored"
last="${!#}"
text() { python3 -c 'import json,sys; print(json.dumps({"type":"text","timestamp":1,"sessionID":"ses_x","part":{"type":"text","text":sys.argv[1]}}))' "$1"; }
# The writing judge: answer yes to every numbered question.
if [ -z "$cmd" ] && printf '%s' "$last" | grep -q 'You are grading a document'; then
  n=$(printf '%s\n' "$last" | grep -cE '^[0-9]+\. ')
  ans=$(python3 -c 'import json,sys; n=int(sys.argv[1]); print(json.dumps({"answers":[{"q":i+1,"yes":True,"why":"fake"} for i in range(n)]}))' "$n")
  text "$ans"; finish 50 20 0; exit 0
fi
# Suggest-Fix: propose renaming the file's first ## heading.
if [ -z "$cmd" ] && printf '%s' "$last" | grep -q 'You improve prompts'; then
  h=$(printf '%s\n' "$last" | grep -m1 '^## ')
  ans=$(python3 -c 'import json,sys; print(json.dumps({"find":sys.argv[1],"replace":sys.argv[1]+" (clearer)","reason":"fake suggestion"}))' "$h")
  text "$ans"; finish 80 40 0; exit 0
fi
case "$cmd" in
  spec)
    # One gate: /spec drafts spec, plan and tasks together.
    printf 'Status: DRAFT\n\n# Spec\n' > "$work/spec.md"
    printf 'Status: DRAFT\n\n# Plan\n' > "$work/plan.md"
    printf '# Tasks\n\n## [ ] Task 1: Settings\n\n- Repo: sample-api\n\n---\n\n## [ ] Task 2: Rule\n\n- Repo: sample-api\n' > "$work/tasks.md"
    tool question; finish 100 50 0.01 ;;
  do-task)
    grep -q '^Status: APPROVED' "$work/spec.md" && grep -q '^Status: APPROVED' "$work/plan.md" || { echo "gate not approved" >&2; exit 3; }
    last="${!#}"; n=$(echo "$last" | awk '{print $2}')
    echo "task $n" >> "$work/done.txt"
    if [ "$n" = "1" ]; then printf '\n## 2026-11-15 | /do-task | implementer\n\n- Stats: verify=FAIL full=PASS\n' >> "$work/progress.md"; fi
    finish 100 50 0.01
    if [ "$n" = "2" ] && [ -z "${FAKE_BREAK:-}" ]; then cp "$FAKE_CORRECT"/src/Orders/*.cs sample-api/src/Orders/; fi ;;
  "")
    # Plain prompt: Tandem must be out of the config folder opencode reads.
    tool read; finish 300 100 0
    if grep -q '"instructions"' "${XDG_CONFIG_HOME:-/nonexistent}/opencode/opencode.json" 2>/dev/null; then echo "Tandem rules leaked" >&2; exit 4; fi
    cat > sample-api/src/Orders/OrderTotals.cs <<'CS'
namespace Orders;
public static class OrderTotals
{
    public static decimal Calculate(Order order)
    {
        var subtotal = order.Lines!.Sum(l => l.Quantity * l.UnitPrice);
        if (order.Lines!.Sum(l => l.Quantity) >= 10) subtotal -= subtotal * 0.05m;
        return Math.Round(subtotal, PricingOptions.Decimals, MidpointRounding.AwayFromZero);
    }
    public static decimal LegacyRound(decimal value) => Math.Round(value, 2);
}
CS
    ;;
esac
exit 0
