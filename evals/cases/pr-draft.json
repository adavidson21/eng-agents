{
  "description": "/pr drafts short PR text for a built item: one section per repo with branch, title, a why-first description and a testing line; no ADO link for a local item; nothing in the repo changes.",
  "command": "pr",
  "arguments": "L1",
  "workItem": "L1-bulk-discount",
  "branch": "dev/feature/L1-bulk-discount",
  "work": [
    {
      "from": "L1/start",
      "to": "L1-bulk-discount"
    },
    {
      "from": "L1/spec-approved",
      "to": "L1-bulk-discount"
    },
    {
      "from": "L1/plan-approved",
      "to": "L1-bulk-discount"
    },
    {
      "from": "L1/built",
      "to": "L1-bulk-discount"
    }
  ],
  "repoCommits": [
    {
      "from": "L1-correct",
      "message": "Bulk discount for 10 or more items"
    }
  ],
  "expect": {
    "files": [
      {
        "path": ".work/L1-bulk-discount/pr.md",
        "headings": [
          "## sample-api"
        ],
        "matches": [
          "\\*\\*Title:\\*\\*",
          "(?m)^Testing:",
          "dev/feature/L1-bulk-discount"
        ],
        "notMatches": [
          "AB#"
        ],
        "maxWords": 300
      }
    ],
    "repo": "unchanged"
  },
  "grader": "Test-Expect"
}
