{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "{{ENG_CONFIG}}/memory.md"
  ],
  "permission": {
    "edit": {
      "*": "allow",
      "**/.git/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.config/opencode/**": "ask",
      "**/opencode.json": "ask",
      "**/opencode.jsonc": "ask"
    },
    "webfetch": "allow",
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "ask",
      "~/.aws/**": "ask",
      "~/.azure/**": "ask",
      "~/.kube/**": "ask",
      "~/.docker/**": "ask",
      "~/.gnupg/**": "ask",
      "~/.git-credentials": "ask",
      "~/.npmrc": "ask",
      "~/AppData/Roaming/Microsoft/Credentials/**": "ask",
      "~/AppData/Roaming/Microsoft/Protect/**": "ask"
    },
    "doom_loop": "ask",
    "bash": {
      "*": "allow",
      "{{BASH:guards}}": "include"
    }
  }
}
