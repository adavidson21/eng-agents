{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "{{ENG_CONFIG}}/memory.md"
  ],
  "permission": {
    "edit": {
      "*": "allow",
      "**/.git/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "webfetch": "ask",
    "external_directory": {
      "*": "ask",
      "{{ENG_HOME}}/**": "allow",
      "{{ENG_CONFIG}}/**": "allow"
    },
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "{{BASH:read}}": "include",
      "{{BASH:build}}": "include",
      "{{BASH:guards}}": "include"
    }
  }
}
