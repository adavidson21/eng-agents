{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "webfetch": "ask",
    "external_directory": {
      "*": "ask",
      "{{ENG_HOME}}/**": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git -C * status*": "allow",
      "git -C * diff*": "allow",
      "git -C * log*": "allow",
      "git -C * show*": "allow",
      "git -C * branch*": "allow",
      "git -C * rev-parse*": "allow",
      "git push*": "deny",
      "git -C * push*": "deny",
      "git reset --hard*": "deny",
      "git -C * reset --hard*": "deny",
      "git clean*": "deny",
      "git -C * clean*": "deny",
      "dotnet ef database*": "deny",
      "dotnet ef migrations remove*": "deny"
    }
  }
}
